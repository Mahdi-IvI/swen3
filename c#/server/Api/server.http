@server_HostAddress = http://localhost:5176
@token = paste-jwt-from-login-response
@documentId = 1
@folderId = 1
@childFolderId = 2

### Register
POST {{server_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "username": "mahdi",
  "password": "password123",
  "email": "mahdi@dom.com",
  "firstName": "Mahdi",
  "lastName": "Abbasi"
}

### Log in
POST {{server_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "username": "mahdi",
  "password": "password123"
}

### Get profile
GET {{server_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}

### Update profile
PUT {{server_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "firstName": "Mahdi",
  "lastName": "Abbasi"
}

### Create a folder
POST {{server_HostAddress}}/api/folders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Projects",
  "description": "Project documents"
}

### Create a child folder
POST {{server_HostAddress}}/api/folders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Folder 1",
  "description": "Sample Description",
  "containingFolder": {{folderId}}
}

### List folders
GET {{server_HostAddress}}/api/folders
Authorization: Bearer {{token}}

### Get folder
GET {{server_HostAddress}}/api/folders/{{folderId}}
Authorization: Bearer {{token}}

### Update folder
PUT {{server_HostAddress}}/api/folders/{{childFolderId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": {{childFolderId}},
  "name": "Sprint 1 updated",
  "description": "Updated Sprint 1 materials",
  "containingFolder": {{folderId}}
}

### Create document
POST {{server_HostAddress}}/api/documents
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "document",
  "description": "document description",
  "fileName": "document.pdf"
}

### List documents
GET {{server_HostAddress}}/api/documents
Authorization: Bearer {{token}}

### Get document
GET {{server_HostAddress}}/api/documents/{{documentId}}
Authorization: Bearer {{token}}

### Search documents
GET {{server_HostAddress}}/api/documents/search?term=document
Authorization: Bearer {{token}}

### Update document
PUT {{server_HostAddress}}/api/documents/{{documentId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "id": {{documentId}},
  "name": "document (updated)",
  "description": "Updated Document",
  "fileName": "document.pdf"
}

### Delete document
DELETE {{server_HostAddress}}/api/documents/{{documentId}}
Authorization: Bearer {{token}}

### Delete folder
DELETE {{server_HostAddress}}/api/folders/{{folderId}}
Authorization: Bearer {{token}}
